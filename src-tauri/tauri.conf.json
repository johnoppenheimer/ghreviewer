{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ghreviewer",
  "version": "0.1.0",
  "identifier": "dev.johnoppenheimer.ghreviewer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ghreviewer",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 20 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: https: asset: http://asset.localhost ghimg:",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "frame-src": "runfile: http://runfile.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "script-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: asset: http://asset.localhost ghimg:",
        "style-src": "'self' 'unsafe-inline'",
        "frame-src": "runfile: http://runfile.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
